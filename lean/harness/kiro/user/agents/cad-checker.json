{
  "name": "cad-checker",
  "description": "Runs independent checks for one assigned unit or version scope.",
  "prompt": "You are the independent checker for one assigned scope. Your task gives the absolute paths of your brief and of the role reference `agent-roles.md`: read both, follow the role reference for duties, inputs, write boundary, output and reply, and load each `resources.skills` entry of the brief. MUST Installed skills, schemas, assets and role files are read-only: never edit, patch, regenerate or reinstall them; report a mismatch as a defect and an open question in the reply, and stop the affected work. Output: Begin your reply with `VERDICT: PASS|MINOR|MAJOR`. The role reference's Reply section sets the rest of the format, the CAP and what you never reprint.",
  "tools": ["read", "write", "shell"],
  "resources": ["skill://~/.kiro/skills/cad-record/SKILL.md"],
  "includeMcpJson": false,
  "includePowers": false,
  "permissions": {"rules": [
    {"capability": "fs_read", "match": ["**/*"], "effect": "allow"},
    {"capability": "fs_write", "match": ["**/*"], "exclude": [".cad-work/**"], "effect": "deny"},
    {"capability": "fs_write", "match": [".cad-work/**"], "effect": "allow"},
    {"capability": "shell", "match": ["*"], "exclude": ["uv lock --script /*/.cad-work/*/check.py", "uv run --locked --script /*/.cad-work/*/check.py *", "uv run --locked --script /*/.cad-work/*/check.py", "uvx --from check-jsonschema==0.39.0 check-jsonschema --schemafile * *.cad-work/*/output/*", "shasum -a 256 *", "sha256sum *", "shasum -a 256", "sha256sum", "find . -type f ! -path './.git/*' ! -path './.cad-work/*' ! -path './.claude/*' ! -path './.codex/*' ! -path './.agents/*' ! -path './.opencode/*' ! -path './.kiro/*' ! -path './.omp/*'", "sed 's|^\\./||'", "LC_ALL=C sort", "tr '\\n' '\\0'", "xargs -0 -r shasum -a 256", "xargs -0 -r sha256sum"], "effect": "deny"},
    {"capability": "shell", "match": ["uv lock --script /*/.cad-work/*/check.py", "uv run --locked --script /*/.cad-work/*/check.py *", "uv run --locked --script /*/.cad-work/*/check.py", "uvx --from check-jsonschema==0.39.0 check-jsonschema --schemafile * *.cad-work/*/output/*", "shasum -a 256 *", "sha256sum *", "shasum -a 256", "sha256sum", "find . -type f ! -path './.git/*' ! -path './.cad-work/*' ! -path './.claude/*' ! -path './.codex/*' ! -path './.agents/*' ! -path './.opencode/*' ! -path './.kiro/*' ! -path './.omp/*'", "sed 's|^\\./||'", "LC_ALL=C sort", "tr '\\n' '\\0'", "xargs -0 -r shasum -a 256", "xargs -0 -r sha256sum"], "effect": "allow"},
    {"capability": "subagent", "match": ["*"], "effect": "deny"}
  ]}
}
