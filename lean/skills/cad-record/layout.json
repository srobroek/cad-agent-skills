      "stage": "GROUND",
      "condition": {"kind": "CONDITIONAL", "when": "a DR is APPROVED or REJECTED"},
      "gate_credit": true,
      "meaning": "the user's or authority's message that approves or rejects a DR; statement.transcript_sha256 hashes it"
