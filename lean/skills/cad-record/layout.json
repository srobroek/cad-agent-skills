      "kind": "RECORD",
      "schema": null,
      "format": "MD",
      "owner": "cad-design",
      "writer": "lead, merging a concept delivery verbatim",
      "mutability": "IMMUTABLE",
      "stage": "CONCEPT",
      "condition": {"kind": "CONDITIONAL", "when": "CONCEPT produced variants"},
