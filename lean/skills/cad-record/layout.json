      "format": "YAML",
      "owner": "cad-select",
      "writer": "lead",
      "mutability": "CONTROLLED",
      "stage": "GROUND",
      "condition": {"kind": "ALWAYS"},
      "gate_credit": true,
      "meaning": "material, process and architecture candidates and the recommendation"
    },
    {
      "id": "record.manufacturing_source",
      "path": "hw/manufacturing/sources/{SHA}/{NAME}",
      "kind": "RECORD",
      "schema": null,
      "format": "BYTES",
      "owner": "cad-select",
      "writer": "lead, accepting a sourcing delivery",
      "mutability": "IMMUTABLE",
      "stage": "GROUND",
      "condition": {"kind": "CONDITIONAL", "when": "a fact cites a retained artifact"},
      "gate_credit": true,
