      "mutability": "IMMUTABLE",
      "stage": "ANY",
      "condition": {"kind": "CONDITIONAL", "when": "an IMPORT DR is APPROVED and applied"},
      "gate_credit": false,
      "meaning": "byte-identical original files of an imported record, at their old path below hw/, including legacy programs; readable history, never executed, never evidence"
    },
