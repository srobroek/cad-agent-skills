      "schema": null,
      "format": "BYTES",
      "owner": "cad-design",
      "writer": "lead, merging a concept delivery verbatim",
      "mutability": "IMMUTABLE",
      "stage": "CONCEPT",
      "condition": {"kind": "CONDITIONAL", "when": "the variant has coarse geometry"},
      "gate_credit": false,
      "meaning": "coarse variant geometry and preview; never verification"
    },
    {
      "id": "record.decision",
      "path": "hw/decisions/{DR}.yaml",
      "kind": "RECORD",
      "schema": "decision.schema.json",
      "format": "YAML",
      "owner": "cad-flow",
      "writer": "lead, recording an explicit user or authority statement",
      "mutability": "APPEND_ONLY",
      "stage": "GROUND",
      "condition": {"kind": "ALWAYS"},
      "gate_credit": true,
      "meaning": "one immutable decision; approve, reject and supersede are new DRs"
    },
    {
      "id": "record.decision_proposal",
      "path": "hw/decisions/proposals/{DR}/{NAME}",
      "kind": "RECORD",
      "schema": null,
      "format": "BYTES",
      "owner": "cad-flow",
      "writer": "lead, before writing the DR that binds it",
      "mutability": "IMMUTABLE",
      "stage": "GROUND",
      "condition": {"kind": "CONDITIONAL", "when": "a DR binds a PROPOSAL"},
      "gate_credit": true,
      "meaning": "the immutable proposal bytes (selection, orientation, support, waiver, change, import mapping) a PROPOSAL-bound DR names"
    },
    {
