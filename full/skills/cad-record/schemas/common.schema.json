{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cad-agent-skills common definitions",
  "description": "Shared IDs, safe paths, hashes, units, facts, sources, criteria, facets, findings, authority and waivers. The root validates a contract probe (one or more named definitions) used only by contract fixtures; it is never a runtime file. JSON Schema does not prove set equality, ID uniqueness, references, acyclicity, finiteness, interval order, unit dimensions, quaternion norm, hash bytes, freshness or authority: the semantic check owns those.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 2,
  "required": ["probe"],
  "properties": {
    "probe": {"const": "cad-agent-skills.common"},
    "fact": {"type": "array", "items": {"$ref": "#/$defs/fact"}, "minItems": 1},
    "source": {"type": "array", "items": {"$ref": "#/$defs/source"}, "minItems": 1},
    "quantity": {"type": "array", "items": {"$ref": "#/$defs/quantity"}, "minItems": 1},
    "criterion": {"type": "array", "items": {"$ref": "#/$defs/criterion"}, "minItems": 1},
    "subject": {"type": "array", "items": {"$ref": "#/$defs/subject"}, "minItems": 1},
    "obligation": {"type": "array", "items": {"$ref": "#/$defs/obligation"}, "minItems": 1},
    "finding": {"type": "array", "items": {"$ref": "#/$defs/finding"}, "minItems": 1},
    "waiver": {"type": "array", "items": {"$ref": "#/$defs/waiver"}, "minItems": 1},
    "authority": {"type": "array", "items": {"$ref": "#/$defs/authority"}, "minItems": 1},
    "binding": {"type": "array", "items": {"$ref": "#/$defs/binding"}, "minItems": 1},
    "outcome_entry": {"type": "array", "items": {"$ref": "#/$defs/outcome_entry"}, "minItems": 1},
    "file_hash": {"type": "array", "items": {"$ref": "#/$defs/file_hash"}, "minItems": 1}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}, "minItems": 1},
    "product_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "pn": {"description": "part number", "type": "string", "pattern": "^[A-Z]{2,5}-[0-9]{4}$"},
    "part_rev": {
      "description": "part revision: draft X1, X2… or released letter; only a changed part increases",
      "type": "string",
      "pattern": "^(X[1-9][0-9]*|[A-HJ-NPRTUVWY])$"
    },
    "release_rev": {
      "description": "release package revision letter, distinct from part revisions",
      "type": "string",
      "pattern": "^[A-HJ-NPRTUVWY]$"
    },
    "requirement_id": {"type": "string", "pattern": "^REQ-[0-9]{3}$"},
    "interface_id": {"type": "string", "pattern": "^IF-[0-9]{3}$"},
    "decision_id": {"type": "string", "pattern": "^DR-[0-9]{3}$"},
    "question_id": {"type": "string", "pattern": "^Q-[0-9]{3}$"},
    "assumption_id": {"type": "string", "pattern": "^ASM-[0-9]{3}$"},
    "preference_id": {"type": "string", "pattern": "^PRF-[0-9]{3}$"},
    "version": {
      "description": "one stage attempt, allocated monotonically and never reused",
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "attempt": {
      "description": "one check attempt under hw/checks/vN/<check>/",
      "type": "string",
      "pattern": "^a[1-9][0-9]*$"
    },
    "slug": {"description": "case, variant or check id", "type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "case_id": {"$ref": "#/$defs/slug"},
    "variant_id": {"$ref": "#/$defs/slug"},
    "check_id": {"$ref": "#/$defs/slug"},
    "component_id": {
      "description": "lower_snake_case id of one disconnected solid",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "semantic_id": {
      "description": "semantic feature, region, operation, occurrence, joint or property name; never a face index",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "profile_id": {"description": "material or capability profile id", "type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "unit_id": {
      "description": ".cad-work/<unit> id; lead and stage-* are reserved",
      "type": "string",
      "pattern": "^(?!lead$)(?!stage-)[a-z][a-z0-9_-]*$"
    },
    "stage": {
      "enum": [
        "GROUND",
        "INTENT",
        "SPECIFY",
        "CONCEPT",
        "VARIANT",
        "LAYOUT",
        "PARTS",
        "DETAIL",
        "BOM",
        "ANALYSIS",
        "CRITIQUE",
        "FREEZE",
        "RELEASE"
      ]
    },
    "facet": {
      "description": "independent evidence facet, not an ordinal badge",
      "enum": [
        "CAD_VALID",
        "GEOMETRICALLY_MANUFACTURABLE",
        "PROCESS_PLANNED",
        "SIMULATION_SUPPORTED",
        "PHYSICALLY_VALIDATED"
      ]
    },
    "check_family": {
      "description": "registered check family; stage policy names these, never thresholds",
      "enum": [
        "record.schema",
        "record.semantic",
        "record.ownership",
        "record.inputs",
        "delivery.integrity",
        "intake.use_case",
        "selection.feasibility",
        "selection.sourcing",
        "material.properties",
        "requirements.completeness",
        "interfaces.completeness",
        "check_plan.completeness",
        "variant.integrity",
        "geometry.build",
        "geometry.readback",
        "geometry.export",
        "geometry.identity",
        "geometry.manufacture",
        "geometry.interference",
        "geometry.clearance",
        "motion.sweep",
        "motion.play",
        "motion.access",
        "assembly.operations",
        "fit.limits",
        "fit.stack",
        "process.fdm",
        "process.resin",
        "process.cnc",
        "process.laser",
        "process.waterjet",
        "process.plasma",
        "process.sheet_forming",
        "process.joining",
        "process.casting",
        "process.moulding",
        "process.extrusion",
        "process.secondary",
        "process.other",
        "capability.route",
        "purchase.identity",
        "optical.route",
        "mass.properties",
        "load.hand",
        "load.fea",
        "drawing.coverage",
        "drawing.preview",
        "preview.render",
        "bom.derivation",
        "verification.index",
        "review.mechanical_dfm",
        "physical.test",
        "release.inventory",
        "release.integrity"
      ]
    },
    "skill": {
      "enum": [
        "cad-flow",
        "cad-record",
        "cad-select",
        "cad-design",
        "cad-model",
        "cad-verify",
        "cad-review",
        "cad-release"
      ]
    },
    "role": {
      "enum": [
        "cad-concept-designer",
        "cad-part-designer",
        "cad-checker",
        "cad-mech-dfm-reviewer",
        "cad-sourcing-researcher"
      ]
    },
    "producer_role": {
      "enum": [
        "cad-concept-designer",
        "cad-part-designer",
        "cad-checker",
        "cad-mech-dfm-reviewer",
        "cad-sourcing-researcher",
        "lead"
      ]
    },
    "kernel": {"enum": ["cadquery", "build123d"]},
    "rigor": {
      "description": "documentation depth; never relaxes service evidence",
      "enum": ["maker", "pro", "regulated"]
    },
    "service_class": {
      "enum": [
        "APPEARANCE_CONCEPT",
        "FIT_ASSEMBLY",
        "FUNCTIONAL_DEMO",
        "WORKING_PROTOTYPE",
        "PRODUCTION",
        "SAFETY_CRITICAL",
        "UNKNOWN"
      ]
    },
    "primary_process": {
      "enum": [
        "FDM",
        "RESIN",
        "CNC",
        "LASER",
        "WATERJET",
        "PLASMA",
        "SHEET_FORMING",
        "CASTING",
        "MOULDING",
        "EXTRUSION",
        "PURCHASED",
        "OTHER"
      ]
    },
    "route_kind": {
      "enum": [
        "FDM",
        "RESIN",
        "CNC",
        "LASER",
        "WATERJET",
        "PLASMA",
        "SHEET_FORMING",
        "JOINING",
        "CASTING",
        "MOULDING",
        "EXTRUSION",
        "DRILLING",
        "REAMING",
        "TAPPING",
        "FINISHING",
        "COATING",
        "HEAT_TREATMENT",
        "INSPECTION",
        "PURCHASED",
        "OTHER"
      ]
    },
    "sourcing": {"enum": ["MAKE", "BUY", "MADE_TO_DRAWING"]},
    "function": {
      "enum": [
        "STRUCTURAL",
        "COSMETIC",
        "LOCATING",
        "SLIDING",
        "ROTATING",
        "SEALING",
        "SPRING",
        "THERMAL",
        "ELECTRICAL",
        "OPTICAL",
        "OTHER"
      ]
    },
    "function_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function"],
      "properties": {
        "function": {"$ref": "#/$defs/function"},
        "description": {"$ref": "#/$defs/text"},
        "requirements": {"$ref": "#/$defs/requirement_ids"}
      },
      "if": {"properties": {"function": {"const": "OTHER"}}},
      "then": {"required": ["description"]}
    },
    "dimension_state": {"enum": ["AS_MANUFACTURED", "AFTER_FINISH", "ASSEMBLED"]},
    "severity": {"enum": ["CRITICAL", "MAJOR", "MINOR", "INFO"]},
    "consequence_severity": {"enum": ["NEGLIGIBLE", "MINOR", "MAJOR", "CRITICAL"]},
    "outcome": {
      "description": "one obligation outcome; UNKNOWN and WAIVED are never PASS",
      "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE", "WAIVED"]
    },
    "result": {"description": "aggregate check result", "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"]},
    "unknown_code": {
      "enum": [
        "NOT_RUN",
        "INCOMPLETE",
        "STALE",
        "MISSING_INPUT",
        "UNSUPPORTED_METHOD",
        "TIMEOUT",
        "REQUIRED_UNKNOWN",
        "PHYSICAL_EVIDENCE_REQUIRED"
      ]
    },
    "verification_method": {"enum": ["INSPECTION", "ANALYSIS", "DEMONSTRATION", "TEST"]},
    "waiver_policy": {"enum": ["FORBIDDEN", "APPROVAL_REQUIRED"]},
    "requirement_ids": {"type": "array", "items": {"$ref": "#/$defs/requirement_id"}, "minItems": 1, "uniqueItems": true},
    "semantic_ids": {"type": "array", "items": {"$ref": "#/$defs/semantic_id"}, "minItems": 1, "uniqueItems": true},
    "decision_ids": {"type": "array", "items": {"$ref": "#/$defs/decision_id"}, "minItems": 1, "uniqueItems": true},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {
      "description": "calendar date YYYY-MM-DD, quoted in YAML",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "timestamp": {
      "description": "UTC instant",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
    },
    "url": {"type": "string", "pattern": "^https://\\S+$"},
    "hw_path": {
      "description": "project-relative path under hw/; no dot segments, empty segments, trailing slash, backslash or control character",
      "type": "string",
      "pattern": "^hw/(?!(.*/)?\\.{1,2}(/|$))(?!.*//)(?!.*/$)[^\\\\\\u0000-\\u001f]+$"
    },
    "scratch_path": {
      "description": "project-relative path under .cad-work/; never durable evidence",
      "type": "string",
      "pattern": "^\\.cad-work/(?!(.*/)?\\.{1,2}(/|$))(?!.*//)(?!.*/$)[^\\\\\\u0000-\\u001f]+$"
    },
    "project_path": {
      "description": "project-relative path under hw/ or .cad-work/",
      "type": "string",
      "pattern": "^(hw|\\.cad-work)/(?!(.*/)?\\.{1,2}(/|$))(?!.*//)(?!.*/$)[^\\\\\\u0000-\\u001f]+$"
    },
    "relative_path": {
      "description": "path relative to a stated directory, such as a release package root",
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!(.*/)?\\.{1,2}(/|$))(?!.*//)(?!.*/$)[^\\\\\\u0000-\\u001f]+$"
    },
    "absolute_path": {
      "description": "absolute POSIX path, resolved by the lead preflight",
      "type": "string",
      "pattern": "^/(?!(.*/)?\\.{1,2}(/|$))(?!.*//)(?!.*/$)[^\\\\\\u0000-\\u001f]+$"
    },
    "source_artifact_path": {
      "description": "retained source bytes: hw/manufacturing/sources/<sha256>/<original-name> or hw/parts/<PN>/sources/**",
      "type": "string",
      "pattern": "^hw/(manufacturing/sources/[0-9a-f]{64}/(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001f]+|parts/[A-Z]{2,5}-[0-9]{4}/sources/(?!(.*/)?\\.{1,2}(/|$))(?!.*//)(?!.*/$)[^\\\\\\u0000-\\u001f]+)$"
    },
    "file_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/project_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "file_hashes": {"type": "array", "items": {"$ref": "#/$defs/file_hash"}, "minItems": 0, "uniqueItems": true},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"$ref": "#/$defs/project_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "role": {"enum": ["PROGRAM", "LOCK", "LOG", "GEOMETRY", "IMAGE", "DATA", "REPORT", "SOURCE_EVIDENCE"]}
      }
    },
    "units": {
      "description": "closed unit-symbol set; an unlisted unit is refused, never guessed",
      "enum": [
        "mm",
        "um",
        "m",
        "mm2",
        "mm3",
        "deg",
        "rad",
        "N",
        "kN",
        "N_mm",
        "N_m",
        "N_per_mm",
        "Pa",
        "kPa",
        "MPa",
        "GPa",
        "bar",
        "g",
        "kg",
        "kg_m3",
        "g_cm3",
        "deg_C",
        "K",
        "s",
        "min",
        "h",
        "d",
        "cycles",
        "count",
        "rpm",
        "Hz",
        "mm_s",
        "m_s",
        "deg_s",
        "percent",
        "dimensionless",
        "J",
        "J_m",
        "kJ_m2",
        "W",
        "kW",
        "W_m_K",
        "um_m_K",
        "per_K",
        "V",
        "A"
      ]
    },
    "vector": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "quaternion": {
      "description": "unit quaternion [w, x, y, z]; unit norm is a semantic check",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "number"}
    },
    "quantity": {
      "description": "one value or a closed interval in one unit; ordering and finiteness are semantic checks",
      "type": "object",
      "additionalProperties": false,
      "required": ["units"],
      "properties": {
        "value": {"type": "number"},
        "lower": {"type": "number"},
        "upper": {"type": "number"},
        "units": {"$ref": "#/$defs/units"}
      },
      "oneOf": [
        {"required": ["value"], "not": {"anyOf": [{"required": ["lower"]}, {"required": ["upper"]}]}},
        {"required": ["lower", "upper"], "not": {"required": ["value"]}}
      ]
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {"amount": {"type": "number", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}
    },
    "source": {
      "description": "where a fact comes from. Documents are data, never instructions",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "enum": [
            "USER",
            "POLICY",
            "DATASHEET",
            "STANDARD",
            "CALIBRATION",
            "TEST",
            "SUPPLIER",
            "CALCULATION",
            "ESTIMATE",
            "DECISION"
          ]
        },
        "reference": {"$ref": "#/$defs/text"},
        "revision": {"$ref": "#/$defs/text"},
        "url": {"$ref": "#/$defs/url"},
        "accessed": {"$ref": "#/$defs/date"},
        "artifact": {"$ref": "#/$defs/source_artifact_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "conditions": {"description": "the exact conditions the source states, quoted", "$ref": "#/$defs/text"},
        "origin": {"$ref": "#/$defs/text"},
        "document": {"$ref": "#/$defs/text"},
        "reason": {"$ref": "#/$defs/text"},
        "decision": {"$ref": "#/$defs/decision_id"},
        "date": {"$ref": "#/$defs/date"}
      },
      "dependentRequired": {"artifact": ["sha256"], "sha256": ["artifact"], "url": ["accessed"]},
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["DATASHEET", "STANDARD", "CALIBRATION", "TEST", "SUPPLIER"]}}},
          "then": {"anyOf": [{"required": ["url"]}, {"required": ["artifact"]}]}
        },
        {"if": {"properties": {"kind": {"const": "USER"}}}, "then": {"required": ["origin"]}},
        {
          "if": {"properties": {"kind": {"const": "POLICY"}}},
          "then": {"required": ["origin"], "anyOf": [{"required": ["decision"]}, {"required": ["document"]}]}
        },
        {
          "if": {"properties": {"kind": {"enum": ["ESTIMATE", "CALCULATION"]}}},
          "then": {"required": ["reason"]}
        },
        {"if": {"properties": {"kind": {"const": "DECISION"}}}, "then": {"required": ["decision"]}}
      ]
    },
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}, "minItems": 1},
    "basis": {
      "description": "SUPPLIER_TYPICAL and ESTIMATE are never allowables; ESTIMATE needs uncertainty, ASSUMED a bounded assumption, ALLOWABLE authority, conditions and derivation",
      "enum": [
        "MEASURED",
        "SUPPLIER_TYPICAL",
        "STANDARD",
        "USER_DECLARED",
        "CALCULATED",
        "ESTIMATE",
        "ASSUMED",
        "ALLOWABLE"
      ]
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note"],
      "properties": {
        "lower": {"type": "number"},
        "upper": {"type": "number"},
        "confidence": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "note": {"$ref": "#/$defs/text"}
      },
      "dependentRequired": {"lower": ["upper"], "upper": ["lower"]}
    },
    "authority": {
      "description": "who may approve or supply criteria; production and safety-critical scope need a competent authority",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "basis", "scope"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "role": {
          "enum": ["OWNER", "USER", "DESIGNER", "COMPETENT_AUTHORITY", "REGULATOR", "SUPPLIER", "ORGANISATION"]
        },
        "basis": {"description": "competence or standing", "$ref": "#/$defs/text"},
        "scope": {"$ref": "#/$defs/text"},
        "contact": {"$ref": "#/$defs/text"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {"enum": ["USER", "AUTHORITY", "LEAD", "ROLE"]},
        "name": {"$ref": "#/$defs/text"},
        "role": {"$ref": "#/$defs/role"}
      },
      "if": {"properties": {"kind": {"const": "ROLE"}}},
      "then": {"required": ["role"]}
    },
    "fact_known": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "basis", "sources"],
      "properties": {
        "status": {"const": "KNOWN"},
        "value": true,
        "basis": {"$ref": "#/$defs/basis"},
        "sources": {"$ref": "#/$defs/sources"},
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "conditions": {"$ref": "#/$defs/text"},
        "assumption": {"$ref": "#/$defs/assumption_id"},
        "bounds": {"$ref": "#/$defs/text"},
        "derivation": {"$ref": "#/$defs/text"},
        "authority": {"$ref": "#/$defs/authority"},
        "decision": {"$ref": "#/$defs/decision_id"},
        "note": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {"if": {"properties": {"basis": {"const": "ESTIMATE"}}}, "then": {"required": ["uncertainty"]}},
        {
          "if": {"properties": {"basis": {"const": "ASSUMED"}}},
          "then": {"required": ["assumption", "bounds"]}
        },
        {
          "if": {"properties": {"basis": {"const": "ALLOWABLE"}}},
          "then": {"required": ["conditions", "derivation", "authority"]}
        }
      ]
    },
    "fact_unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "UNKNOWN"},
        "reason": {"$ref": "#/$defs/text"},
        "owner": {"$ref": "#/$defs/text"},
        "question": {"$ref": "#/$defs/question_id"},
        "consequential": {
          "description": "true when the unknown can change a choice, safety or acceptance; it then needs an owner and a question",
          "type": "boolean"
        }
      },
      "if": {"required": ["consequential"], "properties": {"consequential": {"const": true}}},
      "then": {"required": ["owner", "question"]}
    },
    "fact_not_applicable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "reviewed_by"],
      "properties": {
        "status": {"const": "NOT_APPLICABLE"},
        "reason": {"$ref": "#/$defs/text"},
        "reviewed_by": {"$ref": "#/$defs/text"},
        "decision": {"$ref": "#/$defs/decision_id"}
      }
    },
    "fact_open": {"oneOf": [{"$ref": "#/$defs/fact_unknown"}, {"$ref": "#/$defs/fact_not_applicable"}]},
    "fact": {
      "oneOf": [
        {"$ref": "#/$defs/fact_known"},
        {"$ref": "#/$defs/fact_unknown"},
        {"$ref": "#/$defs/fact_not_applicable"}
      ]
    },
    "text_fact": {
      "oneOf": [
        {"allOf": [{"$ref": "#/$defs/fact_known"}, {"properties": {"value": {"$ref": "#/$defs/text"}}}]},
        {"$ref": "#/$defs/fact_unknown"},
        {"$ref": "#/$defs/fact_not_applicable"}
      ]
    },
    "texts_fact": {
      "oneOf": [
        {"allOf": [{"$ref": "#/$defs/fact_known"}, {"properties": {"value": {"$ref": "#/$defs/texts"}}}]},
        {"$ref": "#/$defs/fact_unknown"},
        {"$ref": "#/$defs/fact_not_applicable"}
      ]
    },
    "quantity_fact": {
      "oneOf": [
        {"allOf": [{"$ref": "#/$defs/fact_known"}, {"properties": {"value": {"$ref": "#/$defs/quantity"}}}]},
        {"$ref": "#/$defs/fact_unknown"},
        {"$ref": "#/$defs/fact_not_applicable"}
      ]
    },
    "boolean_fact": {
      "oneOf": [
        {"allOf": [{"$ref": "#/$defs/fact_known"}, {"properties": {"value": {"type": "boolean"}}}]},
        {"$ref": "#/$defs/fact_unknown"},
        {"$ref": "#/$defs/fact_not_applicable"}
      ]
    },
    "money_fact": {
      "oneOf": [
        {"allOf": [{"$ref": "#/$defs/fact_known"}, {"properties": {"value": {"$ref": "#/$defs/money"}}}]},
        {"$ref": "#/$defs/fact_unknown"},
        {"$ref": "#/$defs/fact_not_applicable"}
      ]
    },
    "integer_fact": {
      "oneOf": [
        {
          "allOf": [{"$ref": "#/$defs/fact_known"}, {"properties": {"value": {"type": "integer", "minimum": 0}}}]
        },
        {"$ref": "#/$defs/fact_unknown"},
        {"$ref": "#/$defs/fact_not_applicable"}
      ]
    },
    "criterion": {
      "description": "measurable or categorical acceptance criterion with its source",
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "comparator", "value", "source"],
      "properties": {
        "id": {"$ref": "#/$defs/semantic_id"},
        "property": {"$ref": "#/$defs/semantic_id"},
        "comparator": {"enum": ["GE", "LE", "GT", "LT", "BETWEEN", "EQUALS", "ONE_OF"]},
        "value": true,
        "units": {"$ref": "#/$defs/units"},
        "state": {"$ref": "#/$defs/dimension_state"},
        "source": {"$ref": "#/$defs/source"},
        "conditions": {"$ref": "#/$defs/text"},
        "note": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {
          "if": {"properties": {"comparator": {"enum": ["GE", "LE", "GT", "LT"]}}},
          "then": {"required": ["units"], "properties": {"value": {"type": "number"}}}
        },
        {
          "if": {"properties": {"comparator": {"const": "BETWEEN"}}},
          "then": {
            "required": ["units"],
            "properties": {"value": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}
          }
        },
        {
          "if": {"properties": {"comparator": {"const": "EQUALS"}}},
          "then": {"properties": {"value": {"type": ["number", "string", "boolean"]}}}
        },
        {
          "if": {"properties": {"comparator": {"const": "EQUALS"}, "value": {"type": "number"}}},
          "then": {"required": ["units"]}
        },
        {
          "if": {"properties": {"comparator": {"const": "ONE_OF"}}},
          "then": {
            "properties": {
              "value": {"type": "array", "items": {"type": ["string", "number"]}, "minItems": 1, "uniqueItems": true}
            }
          }
        }
      ]
    },
    "criterion_or_unknown": {"oneOf": [{"$ref": "#/$defs/criterion"}, {"$ref": "#/$defs/fact_unknown"}]},
    "subject": {
      "description": "what a statement, check, finding or evidence is about; features are semantic, never persistent face indices",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "PRODUCT",
            "ASSEMBLY",
            "PART",
            "COMPONENT",
            "OPERATION",
            "FEATURE",
            "INTERFACE",
            "ASSEMBLY_OPERATION",
            "REQUIREMENT",
            "CASE",
            "OCCURRENCE"
          ]
        },
        "PN": {"$ref": "#/$defs/pn"},
        "occurrence": {"$ref": "#/$defs/semantic_id"},
        "component": {"$ref": "#/$defs/component_id"},
        "operation": {"$ref": "#/$defs/semantic_id"},
        "feature": {"$ref": "#/$defs/semantic_id"},
        "region": {"$ref": "#/$defs/semantic_id"},
        "interface": {"$ref": "#/$defs/interface_id"},
        "assembly_operation": {"$ref": "#/$defs/slug"},
        "requirement": {"$ref": "#/$defs/requirement_id"},
        "case": {"$ref": "#/$defs/case_id"}
      },
      "dependentRequired": {"component": ["PN"], "operation": ["PN"], "region": ["feature"]},
      "allOf": [
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "PART"}}},
          "then": {"required": ["PN"]}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "COMPONENT"}}},
          "then": {"required": ["PN", "component"]}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "OPERATION"}}},
          "then": {"required": ["PN", "operation"]}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "FEATURE"}}},
          "then": {"required": ["feature"]}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "INTERFACE"}}},
          "then": {"required": ["interface"]}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "ASSEMBLY_OPERATION"}}},
          "then": {"required": ["assembly_operation"]}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "REQUIREMENT"}}},
          "then": {"required": ["requirement"]}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "CASE"}}},
          "then": {"required": ["case"]}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "OCCURRENCE"}}},
          "then": {"required": ["occurrence"]}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "FEATURE"}}},
          "then": {"anyOf": [{"required": ["PN"]}, {"required": ["interface"]}]}
        }
      ]
    },
    "subjects": {"type": "array", "items": {"$ref": "#/$defs/subject"}, "minItems": 1},
    "obligation_id": {
      "description": "<family>@<anchor>; anchor is product, assembly, PN[.component][/operation][#feature], IF-###[#feature], REQ-###, op.<assembly operation> or case.<case>",
      "type": "string",
      "pattern": "^(record\\.schema|record\\.semantic|record\\.ownership|record\\.inputs|delivery\\.integrity|intake\\.use_case|selection\\.feasibility|selection\\.sourcing|material\\.properties|requirements\\.completeness|interfaces\\.completeness|check_plan\\.completeness|variant\\.integrity|geometry\\.build|geometry\\.readback|geometry\\.export|geometry\\.identity|geometry\\.manufacture|geometry\\.interference|geometry\\.clearance|motion\\.sweep|motion\\.play|motion\\.access|assembly\\.operations|fit\\.limits|fit\\.stack|process\\.fdm|process\\.resin|process\\.cnc|process\\.laser|process\\.waterjet|process\\.plasma|process\\.sheet_forming|process\\.joining|process\\.casting|process\\.moulding|process\\.extrusion|process\\.secondary|process\\.other|capability\\.route|purchase\\.identity|optical\\.route|mass\\.properties|load\\.hand|load\\.fea|drawing\\.coverage|drawing\\.preview|preview\\.render|bom\\.derivation|verification\\.index|review\\.mechanical_dfm|physical\\.test|release\\.inventory|release\\.integrity)@(product|assembly|[A-Z]{2,5}-[0-9]{4}(\\.[a-z][a-z0-9_]*)?(/[a-z][a-z0-9_]*)?(#[a-z][a-z0-9_]*)?|IF-[0-9]{3}(#[a-z][a-z0-9_]*)?|REQ-[0-9]{3}|op\\.[a-z][a-z0-9_-]*|case\\.[a-z][a-z0-9_-]*)$"
    },
    "finding_id": {
      "description": "stable <family>:<anchor>:<feature-or-operation>; never positional",
      "type": "string",
      "pattern": "^(record\\.schema|record\\.semantic|record\\.ownership|record\\.inputs|delivery\\.integrity|intake\\.use_case|selection\\.feasibility|selection\\.sourcing|material\\.properties|requirements\\.completeness|interfaces\\.completeness|check_plan\\.completeness|variant\\.integrity|geometry\\.build|geometry\\.readback|geometry\\.export|geometry\\.identity|geometry\\.manufacture|geometry\\.interference|geometry\\.clearance|motion\\.sweep|motion\\.play|motion\\.access|assembly\\.operations|fit\\.limits|fit\\.stack|process\\.fdm|process\\.resin|process\\.cnc|process\\.laser|process\\.waterjet|process\\.plasma|process\\.sheet_forming|process\\.joining|process\\.casting|process\\.moulding|process\\.extrusion|process\\.secondary|process\\.other|capability\\.route|purchase\\.identity|optical\\.route|mass\\.properties|load\\.hand|load\\.fea|drawing\\.coverage|drawing\\.preview|preview\\.render|bom\\.derivation|verification\\.index|review\\.mechanical_dfm|physical\\.test|release\\.inventory|release\\.integrity):(product|assembly|[A-Z]{2,5}-[0-9]{4}(\\.[a-z][a-z0-9_]*)?(/[a-z][a-z0-9_]*)?(#[a-z][a-z0-9_]*)?|IF-[0-9]{3}(#[a-z][a-z0-9_]*)?|REQ-[0-9]{3}|op\\.[a-z][a-z0-9_-]*|case\\.[a-z][a-z0-9_-]*):[a-z][a-z0-9_-]*$"
    },
    "obligation": {
      "description": "one expected check, enumerated before any producer runs",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "check", "subject", "facet", "due", "basis"],
      "properties": {
        "id": {"$ref": "#/$defs/obligation_id"},
        "family": {"$ref": "#/$defs/check_family"},
        "check": {"$ref": "#/$defs/check_id"},
        "subject": {"$ref": "#/$defs/subject"},
        "facet": {"$ref": "#/$defs/facet"},
        "due": {"$ref": "#/$defs/stage"},
        "requirement": {"$ref": "#/$defs/requirement_id"},
        "basis": {"$ref": "#/$defs/text"},
        "safety": {"type": "boolean"}
      }
    },
    "waiver": {
      "description": "explicit scoped approved waiver: qualified readiness, never physical evidence; the obligation stays UNKNOWN or FAIL underneath",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "obligation",
        "subject",
        "criterion",
        "classification",
        "retained_outcome",
        "safety_or_regulatory",
        "limitation",
        "operating_envelope",
        "reason",
        "consequence",
        "authority"
      ],
      "properties": {
        "decision": {"$ref": "#/$defs/decision_id"},
        "obligation": {"$ref": "#/$defs/obligation_id"},
        "subject": {"$ref": "#/$defs/subject"},
        "criterion": {"$ref": "#/$defs/text"},
        "classification": {"enum": ["UNVALIDATED_TRIAL", "NON_SAFETY_DEVIATION"]},
        "retained_outcome": {"enum": ["UNKNOWN", "FAIL"]},
        "safety_or_regulatory": {
          "description": "a safety or regulatory obligation, or a proven unsafe failure, is never waived",
          "const": false
        },
        "limitation": {"$ref": "#/$defs/text"},
        "operating_envelope": {"$ref": "#/$defs/text"},
        "supervision": {"$ref": "#/$defs/text"},
        "expires": {"$ref": "#/$defs/date"},
        "until_change": {"$ref": "#/$defs/text"},
        "reason": {"$ref": "#/$defs/text"},
        "consequence": {"$ref": "#/$defs/text"},
        "authority": {"$ref": "#/$defs/authority"}
      },
      "anyOf": [{"required": ["expires"]}, {"required": ["until_change"]}]
    },
    "measured": {
      "oneOf": [
        {"$ref": "#/$defs/quantity"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {"text": {"$ref": "#/$defs/text"}}
        },
        {"$ref": "#/$defs/fact_unknown"}
      ]
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "tool": {"$ref": "#/$defs/text"},
        "version": {"$ref": "#/$defs/text"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/file_hash"}, "minItems": 1}
      }
    },
    "finding": {
      "description": "one immutable finding: subject, severity, measured value or why unknown, criterion and source, method, uncertainty, consequence, remedy with alternatives and the recheck it needs",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "subject",
        "severity",
        "outcome",
        "measured",
        "criterion",
        "method",
        "uncertainty",
        "consequence",
        "recheck"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/finding_id"},
        "family": {"$ref": "#/$defs/check_family"},
        "obligation": {"$ref": "#/$defs/obligation_id"},
        "subject": {"$ref": "#/$defs/subject"},
        "severity": {"$ref": "#/$defs/severity"},
        "outcome": {"$ref": "#/$defs/outcome"},
        "measured": {"$ref": "#/$defs/measured"},
        "criterion": {"$ref": "#/$defs/criterion_or_unknown"},
        "requirements": {"$ref": "#/$defs/requirement_ids"},
        "method": {"$ref": "#/$defs/method"},
        "uncertainty": {"$ref": "#/$defs/text"},
        "assumptions": {"$ref": "#/$defs/texts"},
        "consequence": {"$ref": "#/$defs/text"},
        "remedy": {"$ref": "#/$defs/text"},
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "tradeoff"],
            "properties": {"text": {"$ref": "#/$defs/text"}, "tradeoff": {"$ref": "#/$defs/text"}}
          },
          "minItems": 1
        },
        "recheck": {
          "type": "object",
          "additionalProperties": false,
          "required": ["families", "earliest_stage"],
          "properties": {
            "families": {"type": "array", "items": {"$ref": "#/$defs/check_family"}, "minItems": 1, "uniqueItems": true},
            "scope": {"$ref": "#/$defs/subjects"},
            "earliest_stage": {"$ref": "#/$defs/stage"}
          }
        }
      },
      "if": {"properties": {"outcome": {"enum": ["FAIL", "UNKNOWN"]}}},
      "then": {"required": ["remedy"]}
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["FULL", "GRID", "CONSTRAINED_PATH", "ENDPOINTS_EVENTS", "SAMPLED"]},
        "count": {"type": "integer", "minimum": 1},
        "step": {"$ref": "#/$defs/quantity"},
        "unsampled": {"$ref": "#/$defs/texts"},
        "justification": {"$ref": "#/$defs/text"}
      },
      "if": {"properties": {"kind": {"enum": ["CONSTRAINED_PATH", "SAMPLED"]}}},
      "then": {"required": ["justification"]}
    },
    "outcome_entry": {
      "description": "one obligation outcome inside a check result",
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation", "subject", "facet", "outcome", "method"],
      "properties": {
        "obligation": {"$ref": "#/$defs/obligation_id"},
        "requirement": {"$ref": "#/$defs/requirement_id"},
        "subject": {"$ref": "#/$defs/subject"},
        "facet": {"$ref": "#/$defs/facet"},
        "outcome": {"$ref": "#/$defs/outcome"},
        "value": {
          "oneOf": [
            {"$ref": "#/$defs/quantity"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["text"],
              "properties": {"text": {"$ref": "#/$defs/text"}}
            }
          ]
        },
        "reason": {"$ref": "#/$defs/text"},
        "unknown_code": {"$ref": "#/$defs/unknown_code"},
        "reviewed_by": {"$ref": "#/$defs/text"},
        "criterion": {"$ref": "#/$defs/criterion_or_unknown"},
        "method": {"$ref": "#/$defs/method"},
        "assumptions": {"$ref": "#/$defs/texts"},
        "uncertainty": {"$ref": "#/$defs/text"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/file_hash"}, "minItems": 1},
        "configuration": {"$ref": "#/$defs/text"},
        "sampling": {"$ref": "#/$defs/sampling"},
        "waiver": {"$ref": "#/$defs/decision_id"},
        "limitation": {"$ref": "#/$defs/text"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding_id"}, "minItems": 1, "uniqueItems": true}
      },
      "allOf": [
        {
          "if": {"required": ["outcome"], "properties": {"outcome": {"const": "PASS"}}},
          "then": {
            "required": ["criterion", "evidence", "value"],
            "properties": {"criterion": {"$ref": "#/$defs/criterion"}}
          }
        },
        {
          "if": {"required": ["outcome"], "properties": {"outcome": {"const": "FAIL"}}},
          "then": {"required": ["criterion", "evidence", "value"]}
        },
        {
          "if": {"required": ["outcome"], "properties": {"outcome": {"const": "UNKNOWN"}}},
          "then": {"required": ["reason", "unknown_code"]}
        },
        {
          "if": {"required": ["outcome"], "properties": {"outcome": {"const": "NOT_APPLICABLE"}}},
          "then": {"required": ["reason", "reviewed_by"]}
        },
        {
          "if": {"required": ["outcome"], "properties": {"outcome": {"const": "WAIVED"}}},
          "then": {"required": ["waiver", "limitation"]}
        }
      ]
    },
    "binding": {
      "description": "UNIT binds a pre-integration unit input; VERSION binds an immutable version manifest. UNIT never approves a stage",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "unit", "brief_sha256", "input_inventory_sha256"],
          "properties": {
            "kind": {"const": "UNIT"},
            "unit": {"$ref": "#/$defs/unit_id"},
            "brief_sha256": {"$ref": "#/$defs/sha256"},
            "input_inventory_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "version", "version_manifest_sha256"],
          "properties": {
            "kind": {"const": "VERSION"},
            "version": {"$ref": "#/$defs/version"},
            "version_manifest_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}}
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {"os": {"$ref": "#/$defs/text"}, "arch": {"$ref": "#/$defs/text"}, "python": {"$ref": "#/$defs/text"}}
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "exit_code"],
      "properties": {
        "argv": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "cwd": {"$ref": "#/$defs/absolute_path"},
        "exit_code": {"type": "integer"},
        "timeout_s": {"type": "number", "exclusiveMinimum": 0},
        "stdout": {"$ref": "#/$defs/project_path"},
        "stderr": {"$ref": "#/$defs/project_path"}
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "magnitude", "direction"],
      "properties": {
        "id": {"$ref": "#/$defs/semantic_id"},
        "kind": {"enum": ["STATIC", "SUSTAINED", "CYCLIC", "IMPACT", "VIBRATION"]},
        "magnitude": {"$ref": "#/$defs/quantity_fact"},
        "direction": {"$ref": "#/$defs/text_fact"},
        "application": {"$ref": "#/$defs/subject"},
        "duration": {"$ref": "#/$defs/quantity_fact"},
        "frequency": {"$ref": "#/$defs/quantity_fact"},
        "cycles": {"$ref": "#/$defs/quantity_fact"},
        "requirements": {"$ref": "#/$defs/requirement_ids"},
        "note": {"$ref": "#/$defs/text"}
      }
    },
    "gen_header_format": {"type": "string", "pattern": "^cad-agent-skills\\.[a-z][a-z0-9-]*$"}
  }
}
