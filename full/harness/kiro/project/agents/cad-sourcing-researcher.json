    {"capability": "fs_write", "match": ["**/*"], "exclude": [".cad-work/**"], "effect": "deny"},
    {"capability": "fs_write", "match": [".cad-work/**"], "effect": "allow"},
    {"capability": "shell", "match": ["*--no-project*", "*../*", "LC_ALL=C sort * -o*", "sort * -o*", "LC_ALL=C sort *--output*", "sort *--output*", "mkdir -p /* *", "curl -fsSL -o /* * --compressed*", "curl -fsSL --create-dirs -o /* * --compressed*", "curl * --retry-max-time 20 * *", "*>*/hw/*", "*>hw/*", "*> hw/*", "*>\"hw/*", "*> \"hw/*", "*>'hw/*", "*> 'hw/*", "*>*.git/*", "*>*.claude/*", "*>*.codex/*", "*>*.agents/*", "*>*.opencode/*", "*>*.kiro/*", "*>*.omp/*"], "effect": "deny"},
    {"capability": "shell", "match": ["*"], "exclude": ["env TMPDIR=/*/.cad-work/*/tmp uv lock --cache-dir /*/.cad-work/lead/.uv-cache --no-python-downloads --script /*/.cad-work/*/extract.py", "env TMPDIR=/*/.cad-work/*/tmp uv run --cache-dir /*/.cad-work/lead/.uv-cache --no-python-downloads --locked --script /*/.cad-work/*/extract.py", "env TMPDIR=/*/.cad-work/*/tmp uv run --cache-dir /*/.cad-work/lead/.uv-cache --no-python-downloads --locked --script /*/.cad-work/*/extract.py *", "env TMPDIR=/*/.cad-work/*/tmp /*/.cad-work/lead/validator/bin/check-jsonschema --schemafile * *.cad-work/*/delivery.json*", "env TMPDIR=/*/.cad-work/*/tmp /*/.cad-work/lead/validator/bin/check-jsonschema --schemafile * *.cad-work/*/output/*", "env TMPDIR=/*/.cad-work/*/tmp \"/*/.cad-work/lead/validator/bin/check-jsonschema\" --schemafile * *.cad-work/*/delivery.json*", "env TMPDIR=/*/.cad-work/*/tmp \"/*/.cad-work/lead/validator/bin/check-jsonschema\" --schemafile * *.cad-work/*/output/*", "curl -fsSL -o /*/.cad-work/*/output/* --compressed --remove-on-error --connect-timeout 10 --max-time 60 --max-filesize 64M --retry 1 --retry-max-time 20 *", "curl -fsSL --create-dirs -o /*/.cad-work/*/output/* --compressed --remove-on-error --connect-timeout 10 --max-time 60 --max-filesize 64M --retry 1 --retry-max-time 20 *", "shasum -a 256 *", "sha256sum *", "shasum -a 256", "sha256sum", "find . -type f ! -path './.git/*' ! -path './.cad-work/*' ! -path './.claude/*' ! -path './.codex/*' ! -path './.agents/*' ! -path './.opencode/*' ! -path './.kiro/*' ! -path './.omp/*'", "sed 's|^\\./||'", "LC_ALL=C sort", "sort", "LC_ALL=C sort /*/.cad-work/*", "sort /*/.cad-work/*", "tr '\\n' '\\0'", "xargs -0 -r shasum -a 256", "xargs -0 -r sha256sum", "date -u +%Y-%m-%dT%H:%M:%SZ", "ls -la /*/.cad-work/*", "mkdir -p /*/.cad-work/*"], "effect": "deny"},
    {"capability": "shell", "match": ["env TMPDIR=/*/.cad-work/*/tmp uv lock --cache-dir /*/.cad-work/lead/.uv-cache --no-python-downloads --script /*/.cad-work/*/extract.py", "env TMPDIR=/*/.cad-work/*/tmp uv run --cache-dir /*/.cad-work/lead/.uv-cache --no-python-downloads --locked --script /*/.cad-work/*/extract.py", "env TMPDIR=/*/.cad-work/*/tmp uv run --cache-dir /*/.cad-work/lead/.uv-cache --no-python-downloads --locked --script /*/.cad-work/*/extract.py *", "env TMPDIR=/*/.cad-work/*/tmp /*/.cad-work/lead/validator/bin/check-jsonschema --schemafile * *.cad-work/*/delivery.json*", "env TMPDIR=/*/.cad-work/*/tmp /*/.cad-work/lead/validator/bin/check-jsonschema --schemafile * *.cad-work/*/output/*", "env TMPDIR=/*/.cad-work/*/tmp \"/*/.cad-work/lead/validator/bin/check-jsonschema\" --schemafile * *.cad-work/*/delivery.json*", "env TMPDIR=/*/.cad-work/*/tmp \"/*/.cad-work/lead/validator/bin/check-jsonschema\" --schemafile * *.cad-work/*/output/*", "curl -fsSL -o /*/.cad-work/*/output/* --compressed --remove-on-error --connect-timeout 10 --max-time 60 --max-filesize 64M --retry 1 --retry-max-time 20 *", "curl -fsSL --create-dirs -o /*/.cad-work/*/output/* --compressed --remove-on-error --connect-timeout 10 --max-time 60 --max-filesize 64M --retry 1 --retry-max-time 20 *", "shasum -a 256 *", "sha256sum *", "shasum -a 256", "sha256sum", "find . -type f ! -path './.git/*' ! -path './.cad-work/*' ! -path './.claude/*' ! -path './.codex/*' ! -path './.agents/*' ! -path './.opencode/*' ! -path './.kiro/*' ! -path './.omp/*'", "sed 's|^\\./||'", "LC_ALL=C sort", "sort", "LC_ALL=C sort /*/.cad-work/*", "sort /*/.cad-work/*", "tr '\\n' '\\0'", "xargs -0 -r shasum -a 256", "xargs -0 -r sha256sum", "date -u +%Y-%m-%dT%H:%M:%SZ", "ls -la /*/.cad-work/*", "mkdir -p /*/.cad-work/*"], "effect": "allow"},
    {"capability": "web_search", "match": ["*"], "effect": "allow"},
    {"capability": "web_fetch", "match": ["*"], "effect": "allow"},
