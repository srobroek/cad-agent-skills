{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cad-agent-skills OMP marketplace (.omp-plugin/marketplace.json)",
  "description": "Root catalog listing cad-agent-skills (./full) and cad-agent-skills-lean (./lean); every entry declares version so upgrade-all sees it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "owner", "plugins"],
  "properties": {
    "$schema": {"type": "string"},
    "name": {"const": "cad-agent-skills"},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "email": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {"type": "string", "minLength": 1, "maxLength": 1024},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"}
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "description", "version"],
        "properties": {
          "name": {"enum": ["cad-agent-skills", "cad-agent-skills-lean"]},
          "source": {"enum": ["./full", "./lean"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 1024},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"},
          "category": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
