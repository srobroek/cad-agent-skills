{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cad-agent-skills Kiro CLI v3 agent (harness/kiro/{project,user}/agents/<role>.json)",
  "description": "Closed Kiro CLI v3 agent JSON: thin prompt, tools without subagent, explicit skill resources, no MCP or Powers inclusion, and capability permission rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "prompt", "tools", "resources", "includeMcpJson", "includePowers", "permissions"],
  "properties": {
    "name": {
      "enum": [
        "cad-concept-designer",
        "cad-part-designer",
        "cad-checker",
        "cad-mech-dfm-reviewer",
        "cad-sourcing-researcher"
      ]
    },
    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
    "prompt": {"type": "string", "minLength": 1},
    "tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z_@*][a-z0-9_@/*.-]*$"},
      "not": {"contains": {"const": "subagent"}}
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(file|skill)://\\S+$"}
    },
    "includeMcpJson": {"const": false},
    "includePowers": {"const": false},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "match", "effect"],
            "properties": {
              "capability": {"type": "string", "pattern": "^[a-z_]+$"},
              "match": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "exclude": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "effect": {"enum": ["allow", "deny"]}
            }
          }
        }
      }
    }
  }
}
