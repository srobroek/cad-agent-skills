{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cad-agent-skills Codex custom agent (harness/codex/agents/<role>.toml)",
  "description": "Closed Codex custom agent TOML: name, description and developer_instructions; model and sandbox overrides are omitted so the parent sandbox and approvals apply.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "developer_instructions"],
  "properties": {
    "name": {
      "enum": [
        "cad-concept-designer",
        "cad-part-designer",
        "cad-checker",
        "cad-mech-dfm-reviewer",
        "cad-sourcing-researcher"
      ]
    },
    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
    "developer_instructions": {"type": "string", "minLength": 1},
    "model_reasoning_effort": {"enum": ["minimal", "low", "medium", "high", "xhigh"]},
    "features": {"type": "object", "additionalProperties": {"type": "boolean"}}
  }
}
