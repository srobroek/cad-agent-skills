{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cad-agent-skills example expected obligations (examples/<example>/expected-obligations.yaml)",
  "description": "Closed demo and A/B protocol data for one example: its build mode (absent means a FULL example written before build modes existed), fixed-truth conditions, design-dependent conditions, the stages of that mode with the obligations each must enumerate, the outcomes a correct run may report and the correct end states. Not a record file. Build modes, families, stages and service classes are the cad-record common definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "example",
    "service_class",
    "release_ceiling",
    "conditions",
    "design_dependent",
    "stages",
    "acceptable_ends",
    "open_at_end"
  ],
  "properties": {
    "build_mode": {"$ref": "../../skills/cad-record/schemas/common.schema.json#/$defs/build_mode"},
    "example": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "service_class": {"$ref": "../../skills/cad-record/schemas/common.schema.json#/$defs/service_class"},
    "release_ceiling": {"$ref": "#/definitions/text"},
    "conditions": {
      "description": "families whose condition has a fixed truth value for this brief at every stage that lists them",
      "type": "object",
      "propertyNames": {"$ref": "../../skills/cad-record/schemas/common.schema.json#/$defs/check_family"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["applies", "reason"],
        "properties": {"applies": {"type": "boolean"}, "reason": {"$ref": "#/definitions/text"}}
      }
    },
    "design_dependent": {
      "description": "families whose condition depends on the run's own frozen design: family -> condition text",
      "type": "object",
      "propertyNames": {"$ref": "../../skills/cad-record/schemas/common.schema.json#/$defs/check_family"},
      "additionalProperties": {"$ref": "#/definitions/text"}
    },
    "scripted_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "expected_decision", "expected_rerun", "must_not"],
      "properties": {
        "trigger": {"$ref": "#/definitions/text"},
        "expected_decision": {"$ref": "#/definitions/text"},
        "expected_rerun": {"$ref": "#/definitions/text"},
        "must_not": {"$ref": "#/definitions/texts"}
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "files", "mapping", "decision", "gate_credit"],
      "properties": {
        "source": {"$ref": "#/definitions/text"},
        "files": {"type": "integer", "minimum": 1},
        "mapping": {"$ref": "#/definitions/text"},
        "decision": {"$ref": "#/definitions/text"},
        "gate_credit": {"const": "none"}
      }
    },
    "stages": {
      "description": "the stages of the build mode, in order: definitions/full_stages, or definitions/lite_stages for LITE",
      "type": "array"
    },
    "acceptable_ends": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/definitions/text"},
          {
            "description": "one named end state (SEALED, STOPPED, ...) and its description",
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "propertyNames": {"pattern": "^[A-Z][A-Z_]*$"},
            "additionalProperties": {"$ref": "#/definitions/text"}
          }
        ]
      }
    },
    "never": {"$ref": "#/definitions/texts"},
    "open_at_end": {"type": "array", "items": {"$ref": "#/definitions/text"}}
  },
  "if": {"required": ["build_mode"], "properties": {"build_mode": {"const": "LITE"}}},
  "then": {
    "properties": {
      "service_class": {"const": "APPEARANCE_CONCEPT"},
      "release_ceiling": {"$ref": "#/definitions/lite_disclosure"},
      "stages": {"$ref": "#/definitions/lite_stages"}
    }
  },
  "else": {"properties": {"stages": {"$ref": "#/definitions/full_stages"}}},
  "definitions": {
    "full_stages": {
      "description": "exactly the 13 stages, in order",
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": [
        {"allOf": [{"$ref": "#/definitions/stage_entry"}, {"properties": {"stage": {"const": "GROUND"}}}]},
        {"allOf": [{"$ref": "#/definitions/stage_entry"}, {"properties": {"stage": {"const": "INTENT"}}}]},
        {"allOf": [{"$ref": "#/definitions/stage_entry"}, {"properties": {"stage": {"const": "SPECIFY"}}}]},
        {"allOf": [{"$ref": "#/definitions/stage_entry"}, {"properties": {"stage": {"const": "CONCEPT"}}}]},
        {"allOf": [{"$ref": "#/definitions/stage_entry"}, {"properties": {"stage": {"const": "VARIANT"}}}]},
        {"allOf": [{"$ref": "#/definitions/stage_entry"}, {"properties": {"stage": {"const": "LAYOUT"}}}]},
        {"allOf": [{"$ref": "#/definitions/stage_entry"}, {"properties": {"stage": {"const": "PARTS"}}}]},
        {"allOf": [{"$ref": "#/definitions/stage_entry"}, {"properties": {"stage": {"const": "DETAIL"}}}]},
        {"allOf": [{"$ref": "#/definitions/stage_entry"}, {"properties": {"stage": {"const": "BOM"}}}]},
        {"allOf": [{"$ref": "#/definitions/stage_entry"}, {"properties": {"stage": {"const": "ANALYSIS"}}}]},
        {"allOf": [{"$ref": "#/definitions/stage_entry"}, {"properties": {"stage": {"const": "CRITIQUE"}}}]},
        {"allOf": [{"$ref": "#/definitions/stage_entry"}, {"properties": {"stage": {"const": "FREEZE"}}}]},
        {"allOf": [{"$ref": "#/definitions/stage_entry"}, {"properties": {"stage": {"const": "RELEASE"}}}]}
      ]
    },
    "lite_stages": {
      "description": "exactly GROUND, LAYOUT and RELEASE, in order, with no future obligation: HUMAN gates at GROUND and RELEASE, none at LAYOUT",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": [
        {"allOf": [{"$ref": "#/definitions/stage_entry"}, {"properties": {"stage": {"const": "GROUND"}, "future": {"maxItems": 0}, "gate": {"const": "APPROVED after `approve GROUND <vN>`"}}}]},
        {"allOf": [{"$ref": "#/definitions/stage_entry"}, {"properties": {"stage": {"const": "LAYOUT"}, "future": {"maxItems": 0}, "gate": {"const": "NOT_REQUIRED"}}}]},
        {"allOf": [{"$ref": "#/definitions/stage_entry"}, {"properties": {"stage": {"const": "RELEASE"}, "future": {"maxItems": 0}, "gate": {"const": "APPROVED after `approve RELEASE <vN>`"}}}]}
      ]
    },
    "lite_disclosure": {
      "description": "the exact LITE disclosure line owned by full/skills/cad-flow/SKILL.md; CI checks it is byte-equal there and in the cad-release build-guide asset of both variants",
      "const": "LITE prototype: geometry only; no material, fit, strength or manufacturing claims"
    },
    "text": {"type": "string", "minLength": 1},
    "texts": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/text"}},
    "obligation": {
      "description": "<family>@<anchor>: family is a registered check family (the cad-record common check_family enum), with <placeholders> allowed in the anchor, optionally followed by a parenthesised condition",
      "type": "string",
      "pattern": "^(?:record\\.schema|record\\.semantic|record\\.ownership|record\\.inputs|delivery\\.integrity|intake\\.use_case|selection\\.feasibility|selection\\.sourcing|material\\.properties|requirements\\.completeness|interfaces\\.completeness|check_plan\\.completeness|variant\\.integrity|geometry\\.build|geometry\\.readback|geometry\\.export|geometry\\.identity|geometry\\.manufacture|geometry\\.interference|geometry\\.clearance|motion\\.sweep|motion\\.play|motion\\.access|assembly\\.operations|fit\\.limits|fit\\.stack|process\\.fdm|process\\.resin|process\\.cnc|process\\.laser|process\\.waterjet|process\\.plasma|process\\.sheet_forming|process\\.joining|process\\.casting|process\\.moulding|process\\.extrusion|process\\.secondary|process\\.other|capability\\.route|purchase\\.identity|optical\\.route|mass\\.properties|load\\.hand|load\\.fea|drawing\\.coverage|drawing\\.preview|preview\\.render|bom\\.derivation|verification\\.index|review\\.mechanical_dfm|physical\\.test|release\\.inventory|release\\.integrity)@([^ <>()]|<[^<>]+>)+( \\([^()]+\\))?$"
    },
    "stage_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "expected", "future", "verdict", "gate", "must_show"],
      "properties": {
        "stage": {"$ref": "../../skills/cad-record/schemas/common.schema.json#/$defs/stage"},
        "expected": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/obligation"}},
        "future": {"type": "array", "items": {"$ref": "#/definitions/obligation"}},
        "verdict": {"type": "string", "pattern": "^(PASS|FAIL|BLOCKED)\\b"},
        "gate": {"type": "string", "pattern": "^(APPROVED after `approve [A-Z]+ <vN>[^`]*`|NOT_REQUIRED|NOT_PRESENTED|REVIEW)$"},
        "must_show": {"$ref": "#/definitions/texts"},
        "must_not": {"type": "array", "items": {"$ref": "#/definitions/text"}},
        "post_approval": {"type": "array", "items": {"$ref": "#/definitions/text"}}
      }
    }
  }
}
